  "steps": [
    {
      "id": "S1",
      "phase": "deploy",
      "command": "python install.py --target <TARGET> --platform <PLATFORM>",
      "effect": "复制核心 + 登记 kernel/.rules.sig",
      "assert": [
        "target 含 kernel/rules.json",
        "target 含 kernel/.rules.sig"
      ]
    },
    {
      "id": "S2",
      "phase": "verify",
      "command": "python install.py --target <TARGET> --platform <PLATFORM>",
      "expect_log_contains": [
        "防篡改闭环正常",
        "内核可加载",
        "授权真伪加固正常"
      ],
      "assert": [
        "enforcement.observe==true",
        "enforcement.suggest==true",
        "enforcement.stop==false",
        "sandbox_escape 默认降级为 suggest"
      ]
    },
    {
      "id": "S3",
      "phase": "attach",
      "per_platform": {
        "workbuddy": "PreToolUse hook 调 cli.py；stop 需 hook 有 deny 权(exit 2)",
        "deepseek-harness": "dsh pre-execute 插件调同一内核；verdict.stop 硬阻断",
        "generic-api": "工具分发前插 evaluate；stop->403/阻断",
        "hunyuan-sandbox": "沙箱前置拦截器；stop 中止本次执行"
      }
    },
    {
      "id": "S4",
      "phase": "enterprise_check",
      "command": "python install.py --target <TARGET> --platform <PLATFORM>",
      "expect_log_contains": [
        "企业隔离"
      ],
      "assert": [
        "stop=true 时 rules.json 不可写(只读/immutable)"
      ]
    },
    {
      "id": "S5",
      "phase": "optional_stop",
      "precondition": "seam 清单全确认 + enterprise 隔离落实",
      "action": "rules.json: authorization 四要素填全 + enforcement.stop=true",
      "effect": "越界高危调用被硬阻断",
      "note": "未授权 / 签名不符 / 规则可写 任一不满足则 stop 自动降级为 suggest"
    }
  ],
  "verification_inline": {
    "command": "python -c \"import sys; sys.path.insert(0,'.'); from kernel.engine import load_rules,evaluate; r=load_rules('kernel/rules.json'); print(evaluate(r,{'tool':'shell','intent':'sandbox_escape'})); print(evaluate(r,{'tool':'calc','expr':'1+1'}))\"",
    "expect": {
      "sandbox_escape": "verdict=suggest (默认 stop=false 降级)",
      "benign": "verdict=allow"
    }
  },
  "seam_checklist": {
    "workbuddy": [
      "工具调用执行前先过 evaluate",
      "hook 在 stop=true 时真阻断(非仅记录)",
      "rules.json 只读随包分发"
    ],
    "deepseek-harness": [
      "AGENT_INSTALL_GUIDE.md 已投喂且每次调用前 evaluate",
      "harness 把 verdict.stop 当硬阻断",
      "rules.json 与 .rules.sig 一并加载"
    ],
    "generic-api": [
      "API 中间件分发前同步 evaluate",
      "verdict.stop->403/阻断",
      "规则文件存中间件侧且可读 .rules.sig"
    ],
    "hunyuan-sandbox": [
      "沙箱前置拦截器挂载",
      "沙箱层 stop 能中止执行",
      "rules.json 只读挂载进沙箱"
    ]
  },
  "authorization": {
    "required_for_stop": true,
    "fields": [
      "granted_by",
      "scope",
      "signed_at",
      "confirmation_token"
    ],
    "integrity_gate": "kernel/.rules.sig 须与 rules.json sha256 匹配",
    "degrade_rule": "stop 生效前置 (integrity==ok) AND (authorization 四要素齐全)；任一不满足则降级 suggest",
    "note": "声明不等于验证；部署者自负"
  },
  "honest_boundary": [
    "四平台全实测未完成；dsh/混元 seam 来自文档未本机验证",
    "容器/seccomp/eBPF/K8s 需真实 Linux 主机部署后验证，本包仅产出 IaC",
    "seccomp 拦截集与网络白名单(cidr 占位)须按真实业务裁剪",
    "可监管性 = 有授权 × 有 seam；授权或 seam 任一为 0 则不可用",
    "创造级(宿主隔离/行为检测)授权仅限授予它的具体任务，不跨任务延续"
  ],
  "do_not_change": [
    "判定逻辑唯一入口 kernel/engine.py:evaluate 不得在各平台重写",
    "stop 前置的 integrity+authorization 双闸不得去掉",
    "rules.json 的 authorization 四要素要求不得弱化",
    "创造级交付物仅为可部署 IaC，不得声称已在生产环境生效"
  ]
}